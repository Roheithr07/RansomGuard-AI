# RansomGuard AI - Environment Configuration

# Directories (relative to project root or absolute)
PROTECTED_DIRECTORY=protected_storage
SNAPSHOT_DIRECTORY=snapshots
LOGS_DIRECTORY=logs
DATABASE_PATH=backend/database/ransomguard.db

# Server Bind Settings
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Real-Time Monitoring & Detection Settings
MONITOR_ENABLED=True
ENTROPY_THRESHOLD=7.3
BURST_MODIFICATION_WINDOW_SEC=10
BURST_MODIFICATION_COUNT=8
BURST_RENAME_COUNT=6
BURST_DELETE_COUNT=6
BURST_OPS_PER_SEC_THRESHOLD=12
